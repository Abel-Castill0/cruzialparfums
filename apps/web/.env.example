# Cruzial Platform V2 — environment contract (NAMES ONLY, never real values)
#
# Copy to apps/web/.env.local and fill in from `npx supabase status` for local
# development. .env.local is gitignored; never commit a filled-in copy.

# --- Public: safe to expose in the browser bundle ----------------------------
# The publishable key replaces the legacy `anon` key. It carries no privilege
# of its own — Row Level Security decides what it can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only: never prefixed with NEXT_PUBLIC_ ---------------------------
# The secret key replaces `service_role` and BYPASSES RLS entirely. Adding a
# NEXT_PUBLIC_ prefix to this would inline it into the client bundle and hand
# every visitor full database access. src/lib/supabase/env-contract.test.ts
# fails the build if that ever happens.
SUPABASE_SECRET_KEY=

# Email allowed to bootstrap the first administrator. Provisioning data, not a
# public contact address (see docs/client-decisions.md). Left blank here on
# purpose: the value belongs in the environment, not in the repository.
ADMIN_BOOTSTRAP_EMAIL=
