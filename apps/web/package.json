{
  "name": "@cruzial/platform-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "catalog:export": "node ../../scripts/export-legacy-catalog.mjs",
    "catalog:check": "node ../../scripts/export-legacy-catalog.mjs --check",
    "media:reconcile": "node ../../scripts/client-media-reconciliation.mjs",
    "media:check": "node ../../scripts/client-media-reconciliation.mjs --check",
    "commercial:reconcile": "node ../../scripts/commercial-reconciliation.mjs",
    "commercial:check": "node ../../scripts/commercial-reconciliation.mjs --check",
    "commercial:load:dry": "node ../../scripts/load-commercial-catalog.mjs --dry-run",
    "commercial:load:apply": "node ../../scripts/load-commercial-catalog.mjs --apply",
    "commercial:load:verify": "node ../../scripts/load-commercial-catalog.mjs --verify",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:4j4b": "node --test ../../scripts/import-consolidado-4j4b.test.mjs",
    "test:audit-gate": "node --test ../../scripts/audit-dev-gate.test.mjs",
    "test:backup-crypt": "node --test ../../scripts/backup-crypt.test.mjs",
    "test:monitor-vercel": "node --test ../../scripts/monitor-vercel.test.mjs ../../scripts/lib/alert-channels.test.mjs ../../scripts/monitor-alert-selftest.test.mjs ../../scripts/monitor-workflows.test.mjs ../../scripts/nextjs-security-watch.test.mjs",
    "test:supabase-health": "node --test ../../scripts/supabase-health.test.mjs",
    "test:qa-target": "node --test ../../scripts/qa-target.test.mjs",
    "test:media-migration": "node --test ../../scripts/migrate-client-media.test.mjs",
    "audit:dev": "node ../../scripts/audit-dev-gate.mjs",
    "check": "npm run catalog:check && npm run commercial:check && npm run test:4j4b && npm run test:audit-gate && npm run test:backup-crypt && npm run test:monitor-vercel && npm run test:supabase-health && npm run test:qa-target && npm run test:media-migration && npm run lint && npm run typecheck && npm run test && npm run build",
    "etl:legacy": "node ../../scripts/etl-legacy-catalog.mjs",
    "etl:check": "node ../../scripts/etl-legacy-catalog.mjs --check",
    "db:reset": "npx supabase db reset",
    "db:test": "node ../../scripts/prepare-commercial-reconciliation-test.mjs && npx supabase test db",
    "db:gate": "npm run db:reset && npm run db:test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "~24.x",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/sdk": "1.28.41",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
