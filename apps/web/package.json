{
  "name": "@cruzial/platform-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "catalog:export": "node ../../scripts/export-legacy-catalog.mjs",
    "catalog:check": "node ../../scripts/export-legacy-catalog.mjs --check",
    "media:reconcile": "node ../../scripts/client-media-reconciliation.mjs",
    "media:check": "node ../../scripts/client-media-reconciliation.mjs --check",
    "commercial:reconcile": "node ../../scripts/commercial-reconciliation.mjs",
    "commercial:check": "node ../../scripts/commercial-reconciliation.mjs --check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run catalog:check && npm run commercial:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "etl:legacy": "node ../../scripts/etl-legacy-catalog.mjs",
    "etl:check": "node ../../scripts/etl-legacy-catalog.mjs --check",
    "db:reset": "npx supabase db reset",
    "db:test": "npx supabase test db"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
